{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["replicaCount", "image", "service", "gateway"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy", "tag", "digest"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port", "targetPort"],
      "properties": {
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["enabled", "host", "dnsTarget", "clusterIssuer", "parent"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "dnsTarget": {
          "type": "string",
          "minLength": 1
        },
        "clusterIssuer": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "object",
          "required": ["name", "namespace", "httpSectionName"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "httpSectionName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "gemini": {
      "type": "object",
      "required": [
        "enabled",
        "hostname",
        "port",
        "certSecret",
        "image",
        "externalSecret"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "certSecret": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "externalSecret": {
          "type": "object",
          "required": ["refreshInterval", "lockboxSecretId"],
          "properties": {
            "refreshInterval": {
              "type": "string",
              "minLength": 1
            },
            "lockboxSecretId": {
              "type": "string"
            }
          }
        }
      }
    },
    "tor": {
      "type": "object",
      "required": ["enabled", "keySecret", "externalSecret", "image", "socks5"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "onionAddress": {
          "type": "string"
        },
        "keySecret": {
          "type": "string",
          "minLength": 1
        },
        "externalSecret": {
          "type": "object",
          "required": [
            "refreshInterval",
            "lockboxSecretId",
            "socks5UsernameProperty",
            "socks5PasswordProperty"
          ],
          "properties": {
            "refreshInterval": {
              "type": "string",
              "minLength": 1
            },
            "lockboxSecretId": {
              "type": "string"
            },
            "socks5UsernameProperty": {
              "type": "string",
              "minLength": 1
            },
            "socks5PasswordProperty": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "socks5": {
          "type": "object",
          "required": ["host", "port"],
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    }
  }
}
