---
import "../styles/global.css";

import { siteCopy, type Locale } from "../data/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const canonical = new URL(`/${locale}/`, Astro.site);
const siteName = siteCopy[locale].hero.name;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`/favicon-${locale}.svg`} />
    <link rel="author" type="text/plain" href="/humans.txt" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site)} />
    <link rel="alternate" hreflang="ru" href={new URL("/ru/", Astro.site)} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL("/en/", Astro.site)}
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">
      {locale === "ru" ? "Перейти к содержанию" : "Skip to content"}
    </a>
    <div class="noise" aria-hidden="true"></div>
    <slot />
    <script is:inline>
      document.querySelectorAll("[data-locale]").forEach((link) => {
        link.addEventListener("click", () => {
          const locale = link.getAttribute("data-locale");
          if (locale) {
            try {
              window.localStorage.setItem("leonid.locale", locale);
            } catch {}
          }
        });
      });
    </script>
  </body>
</html>
