---
import { Image } from "astro:assets";

import k8sImage from "../assets/images/project-k8s.png";
import minecraftImage from "../assets/images/project-minecraft.png";
import seinImage from "../assets/images/project-sein.png";
import type { ProjectSlug } from "../data/site";
import RichText from "./RichText.astro";

interface Props {
  slug: ProjectSlug;
  name: string;
  description: string;
  href: string;
  status: string;
  argocdApp?: string;
  technologies: string[];
  extraLink?: { label: string; href: string };
}

const {
  slug,
  name,
  description,
  href,
  status,
  argocdApp,
  technologies,
  extraLink,
} = Astro.props;

const artwork: Record<ProjectSlug, ImageMetadata> = {
  k8s: k8sImage,
  sein: seinImage,
  minecraft: minecraftImage,
};

const image = artwork[slug];
---

<article class="project-entry" data-project={slug}>
  <a
    class="project-icon"
    href={href}
    target="_blank"
    rel="noreferrer"
    aria-label={`${name} — GitHub`}
  >
    <Image src={image} alt="" width={160} densities={[1, 2]} loading="lazy" />
  </a>

  <a
    class="project-visual"
    href={href}
    target="_blank"
    rel="noreferrer"
    aria-label={`${name} — GitHub`}
  >
    <span class="project-cover">
      <Image src={image} alt="" width={640} densities={[1, 2]} loading="lazy" />
    </span>
  </a>

  <div class="project-copy">
    <div class="project-card-topline">
      <span class="project-status" data-argocd-app={argocdApp}>
        <i aria-hidden="true"></i><span data-status-text>{status}</span>
        <span class="project-revision" data-status-revision></span>
      </span>
    </div>
    <h3>
      <a href={href} target="_blank" rel="noreferrer">
        {name}<span aria-hidden="true">↗</span>
      </a>
    </h3>
    <p><RichText text={description} /></p>
    {
      extraLink && (
        <p class="project-extra">
          <a href={extraLink.href} target="_blank" rel="noreferrer">
            {extraLink.label}
            <span aria-hidden="true">↗</span>
          </a>
        </p>
      )
    }
    <ul class="tag-list" aria-label="Technologies">
      {technologies.map((technology) => <li>{technology}</li>)}
    </ul>
  </div>
</article>
