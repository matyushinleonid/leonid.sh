---
import { Image } from "astro:assets";

import portrait from "../../assets/images/portrait.jpg";
import ExperienceEntry from "../../components/ExperienceEntry.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { designs } from "../../data/designs";
import { cvHref, locales, siteCopy, type Locale } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = siteCopy[locale];
const alternateLocale = locale === "en" ? "ru" : "en";
const alternateLabel = locale === "en" ? "RU" : "EN";
const alternateFlag = locale === "en" ? "🇷🇺" : "🇬🇧";
const homeLabel =
  locale === "ru" ? "Главная Леонида Матюшина" : "Leonid Matyushin home";
const navigationLabel =
  locale === "ru" ? "Основная навигация" : "Primary navigation";
---

<BaseLayout
  locale={locale}
  title={copy.meta.title}
  description={copy.meta.description}
>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="wordmark" href={`/${locale}/`} aria-label={homeLabel}>
        <span aria-hidden="true">~/</span>leonid
      </a>

      <nav aria-label={navigationLabel}>
        <a href="#projects">{copy.nav.projects}</a>
        <a href="#experience">{copy.nav.experience}</a>
        <a href="#stack">{copy.nav.stack}</a>
        <a href="#education">{copy.nav.education}</a>
      </nav>

      <div class="design-switcher" role="group" aria-label={copy.labels.layout}>
        <span>{copy.labels.layout}:</span>
        {
          designs.map((design, index) => (
            <button type="button" data-design-button={design.id}>
              {String(index + 1).padStart(2, "0")} {design.label}
            </button>
          ))
        }
      </div>

      <div class="header-actions">
        <a
          class="locale-switch"
          href={`/${alternateLocale}/`}
          data-locale={alternateLocale}
          aria-label={`Switch language to ${alternateLabel}`}
        >
          <span class="locale-flag" aria-hidden="true">{alternateFlag}</span>[{
            alternateLabel
          }]
        </a>
      </div>
    </div>
  </header>

  <main id="content" class="site-main shell">
    <section class="intro" aria-labelledby="hero-heading">
      <div class="intro-copy">
        <p class="eyebrow">{copy.hero.role}</p>
        <h1 id="hero-heading">{copy.hero.name}</h1>
        <p class="hero-location">{copy.hero.location}</p>

        <div class="hero-actions">
          <a class="text-link primary-link" href="#experience">
            <span aria-hidden="true">→</span>{copy.hero.primaryAction}
          </a>
          <a class="text-link" href={cvHref(locale)} download>
            {copy.hero.cvAction}<span aria-hidden="true">↓</span>
          </a>
        </div>

        <ul class="profile-links" aria-label="Contacts">
          {
            copy.links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="me noreferrer">
                  {link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="portrait">
        <div class="portrait-frame">
          <Image
            src={portrait}
            alt={copy.labels.portrait}
            width={640}
            densities={[1, 2]}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </figure>
    </section>

    <div class="resume-layout">
      <div class="resume-primary">
        <section
          class="content-section experience-section"
          id="experience"
          aria-labelledby="experience-title"
        >
          <header class="section-heading">
            <span aria-hidden="true">02</span>
            <div>
              <p>career.md</p>
              <h2 id="experience-title">{copy.labels.selectedExperience}</h2>
            </div>
          </header>
          <div class="experience-list">
            {
              copy.experience.map((experience, index) => (
                <ExperienceEntry {...experience} index={index} />
              ))
            }
          </div>
        </section>
      </div>

      <aside class="resume-secondary">
        <section
          class="content-section projects-section"
          id="projects"
          aria-labelledby="projects-title"
        >
          <header class="section-heading heading-with-note">
            <span aria-hidden="true">01</span>
            <div>
              <p>projects/</p>
              <h2 id="projects-title">{copy.labels.projects}</h2>
            </div>
          </header>
          <div class="project-list">
            {copy.projects.map((project) => <ProjectCard {...project} />)}
          </div>
        </section>

        <section
          class="content-section stack-section"
          id="stack"
          aria-labelledby="stack-title"
        >
          <header class="section-heading small-heading">
            <span aria-hidden="true">03</span>
            <div>
              <p>/etc/toolbox</p>
              <h2 id="stack-title">{copy.labels.stack}</h2>
            </div>
          </header>
          <div class="stack-groups">
            {
              copy.stack.map((group) => (
                <div class="stack-group">
                  <h3>{group.group}</h3>
                  <p>{group.items.join(" · ")}</p>
                </div>
              ))
            }
          </div>
        </section>

        <section
          class="content-section education-section"
          id="education"
          aria-labelledby="education-title"
        >
          <header class="section-heading small-heading">
            <span aria-hidden="true">04</span>
            <div>
              <p>education.md</p>
              <h2 id="education-title">{copy.labels.education}</h2>
            </div>
          </header>
          <div class="education-list">
            {
              copy.education.map((entry) => (
                <article>
                  <span>{entry.period}</span>
                  <h3>{entry.degree}</h3>
                  <p>{entry.institution}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section
          class="content-section achievements-section"
          aria-labelledby="achievements-title"
        >
          <header class="section-heading small-heading">
            <span aria-hidden="true">05</span>
            <div>
              <p>achievements.md</p>
              <h2 id="achievements-title">{copy.labels.achievements}</h2>
            </div>
          </header>
          <div class="achievement-list">
            {
              copy.achievements.map((achievement) => (
                <article>
                  <p>
                    <span>{achievement.period}</span>
                    {achievement.organization && (
                      <span>{achievement.organization}</span>
                    )}
                  </p>
                  <h3>{achievement.name}</h3>
                  <p>{achievement.description}</p>
                </article>
              ))
            }
          </div>
        </section>
      </aside>
    </div>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <a
        href="https://github.com/matyushinleonid/leonid.sh"
        target="_blank"
        rel="noreferrer"
      >
        {copy.labels.source}: github<span aria-hidden="true">↗</span>
      </a>
    </div>
  </footer>
</BaseLayout>

<script>
  const BADGE_ENDPOINT = "https://argocd.leonid.sh/api/badge";
  const TIMEOUT_MS = 5000;

  const HEALTH = new Set([
    "healthy",
    "progressing",
    "degraded",
    "suspended",
    "missing",
    "unknown",
  ]);

  async function resolve(chip: HTMLElement) {
    const app = chip.dataset.argocdApp;
    const label = chip.querySelector("[data-status-text]");
    if (!app || !label) return;

    const timeout = AbortSignal.timeout(TIMEOUT_MS);
    try {
      const url = `${BADGE_ENDPOINT}?name=${encodeURIComponent(app)}&revision=true`;
      const response = await fetch(url, { signal: timeout });
      if (!response.ok) return;

      const badge = new DOMParser().parseFromString(
        await response.text(),
        "image/svg+xml",
      );
      const read = (id: string) =>
        badge.querySelector(id)?.textContent?.trim().toLowerCase() ?? "";

      const health = read("#leftText");
      if (!HEALTH.has(health)) return;

      const sync = read("#rightText");
      label.textContent = [health, sync].filter(Boolean).join(" · ");
      chip.dataset.state = health;

      const revision = read("#revisionText").replace(/[()]/g, "");
      const slot = chip.querySelector("[data-status-revision]");
      if (slot && revision) slot.textContent = revision;
    } catch {}
  }

  document
    .querySelectorAll<HTMLElement>("[data-argocd-app]")
    .forEach((chip) => void resolve(chip));
</script>
